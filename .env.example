# ---------------------------------------------------------------------------
# Anwendung
# ---------------------------------------------------------------------------
# APP_NAME ist zugleich die Wortmarke: Sie erscheint im Logo, im Browser-Tab,
# in E-Mails, PDF-Berichten und auf dem Home-Bildschirm der Web-App.
APP_NAME=Leihregal
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Vienna
APP_URL=https://bibliothek.example.org

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_AT

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Erscheinungsbild und fachlicher Zuschnitt
# ---------------------------------------------------------------------------
# Optional. Die Vorgaben beschreiben eine sozialpädagogische Wohngruppe.
# Wer die Bibliothek in einem anderen Feld betreibt – Schule, Jugendzentrum,
# Beratungsstelle –, formuliert hier um und bekommt sofort passendere
# KI-Empfehlungen. Erläuterungen stehen in config/branding.php.

# BRAND_UNTERTITEL="Medienbibliothek"
# BRAND_BESCHREIBUNG="Medienbibliothek für sozialpädagogische Einrichtungen"
# BRAND_EINRICHTUNG="sozialpädagogische Wohngruppe mit Kindern und Jugendlichen"
# BRAND_FACHKRAEFTE="sozialpädagogische Fachkräfte"
# BRAND_ZIELGRUPPE="Betreuer:innen"
# BRAND_ARBEITSFELD="sozialpädagogischen Arbeit"

# Markenfarben. Nach einer Änderung zusätzlich die Tokens --color-marke-* in
# resources/css/app.css anpassen und `npm run build` ausführen (docs/marke.md).
#
# Anführungszeichen setzen: Ein unmaskiertes `#` leitet in einer .env einen
# Kommentar ein. `BRAND_FARBE=#2563EB` käme leer an.
# BRAND_FARBE="#2563EB"
# BRAND_FARBE_HELL="#3B82F6"
# BRAND_FARBE_DUNKEL="#1D4ED8"
# BRAND_FARBE_HINTERGRUND="#F9FAFB"

# ---------------------------------------------------------------------------
# Datenbank
# ---------------------------------------------------------------------------
# MariaDB ab 11.7 wird empfohlen: Der Spaltentyp VECTOR beschleunigt die
# Ähnlichkeitssuche erheblich. Ohne ihn läuft die Anwendung ebenfalls,
# die Suche fällt dann auf einen Vergleich in PHP zurück.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=leihregal
DB_USERNAME=leihregal
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=leihregal_

# ---------------------------------------------------------------------------
# E-Mail
# ---------------------------------------------------------------------------
# Fristerinnerungen, Reservierungsmeldungen und der Quartalsbericht gehen
# per Mail hinaus. Ohne funktionierenden Versand bleibt der Rest nutzbar.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="bibliothek@example.org"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# KI-Funktionen (optional)
# ---------------------------------------------------------------------------
# Ohne diese Schlüssel läuft die Bibliothek vollständig – Verwaltung,
# Ausleihe, Reservierung, Wünsche, Berichte. Es entfallen lediglich
# Medienanalyse, Assistent, Einsatzhinweise, Kuration und Empfehlungen.

# Anthropic Claude – Medienanalyse, Assistent, Kuration
# https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI – Embeddings für Ähnlichkeitssuche und Empfehlungen
# https://platform.openai.com
OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Books – ISBN-Import. Funktioniert auch ohne Schlüssel,
# mit Schlüssel gilt ein höheres Anfragelimit.
# https://console.cloud.google.com → Books API
GOOGLE_BOOKS_API_KEY=

# ---------------------------------------------------------------------------
# Web-Push (optional)
# ---------------------------------------------------------------------------
# Schlüsselpaar einmalig erzeugen: php artisan push:vapid-keys
# Ein späterer Wechsel macht ALLE bestehenden Abos ungültig.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
